<Window x:Class="AirScope.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:AirScope.Windows.Controls" Title="AirScope · Wi-Fi intelligence" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13" Width="1440" Height="960" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing" StateChanged="OnStateChanged">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="216" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#0D1623" BorderBrush="#233247" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="23,30,15,30"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="28" Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0" /><TextBlock Text="airscope" FontSize="26" FontWeight="SemiBold" /></StackPanel><TextBlock Text="WI-FI INTELLIGENCE" FontSize="9" Foreground="#6C829C" Margin="2,8,0,0" /></StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="22,20,18,25"><Border Background="#162539" CornerRadius="6" Padding="9,5" HorizontalAlignment="Left"><TextBlock Text="WINDOWS NATIVE" FontSize="9" Foreground="#AABBD0" /></Border><TextBlock Text="MT7925 + Sky XER10" Margin="0,12,0,4" FontSize="11" /><TextBlock Text="v0.1 · local by design" FontSize="10" Foreground="#6C829C" /></StackPanel>
        <StackPanel>
          <TextBlock Text="WORKSPACE" FontSize="9" Foreground="#607691" Margin="25,0,0,12" />
          <RadioButton x:Name="OverviewNav" Style="{StaticResource Nav}" Tag="0" Click="Navigate" IsChecked="True" Content="◈    Overview" />
          <RadioButton Style="{StaticResource Nav}" Tag="1" Click="Navigate" Content="⌁    Channel explorer" />
          <RadioButton Style="{StaticResource Nav}" Tag="2" Click="Navigate" Content="▦    Nearby networks" />
          <RadioButton Style="{StaticResource Nav}" Tag="3" Click="Navigate" Content="↗    Speed &amp; diagnostics" />
          <TextBlock Text="CONTROL CENTRE" FontSize="9" Foreground="#607691" Margin="25,25,0,12" />
          <RadioButton Style="{StaticResource Nav}" Tag="4" Click="Navigate" Content="✧    Optimiser" />
          <RadioButton Style="{StaticResource Nav}" Tag="5" Click="Navigate" Content="▣    Hardware &amp; hub" />
          <RadioButton x:Name="RecoveryNav" Style="{StaticResource Nav}" Tag="6" Click="Navigate" Content="⟲    Recovery &amp; settings" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
      <Border BorderBrush="#233247" BorderThickness="0,0,0,1" Padding="28,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock x:Name="HeaderSsid" Text="Discovering your network…" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="HeaderConnection" Text="Waiting for Windows Wi-Fi" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel>
          <Border Grid.Column="1" Background="#122A29" CornerRadius="20" Padding="12,7" VerticalAlignment="Center" Margin="10,0,16,0"><TextBlock x:Name="LiveBadge" Text="●  LIVE MONITOR" Foreground="{StaticResource AccentBrush}" FontSize="10" /></Border>
          <Button Grid.Column="2" x:Name="ScanButton" Content="↻  Scan now" Click="ScanClick" VerticalAlignment="Center" Margin="0,0,10,0" />
          <Button Grid.Column="3" Content="Export report" Click="ExportReportClick" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border x:Name="NoticeBorder" Grid.Row="1" Background="#342B19" BorderBrush="#7F6535" BorderThickness="0,0,0,1" Padding="27,12" Visibility="Collapsed"><DockPanel><Button DockPanel.Dock="Right" Content="Location settings" Click="LocationClick" Padding="12,5" Margin="15,0,0,0" /><TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#F2D397" VerticalAlignment="Center" /></DockPanel></Border>
      <TabControl x:Name="Pages" Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="0" SelectedIndex="0">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent" /></ControlTemplate></TabControl.Template>
        <TabItem Header="Overview">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,26,28,24">
            <TextBlock Text="Your network, in focus." Style="{StaticResource Heading}" /><TextBlock Text="A live view of your connection. A clear path to a better one." Style="{StaticResource Muted}" Margin="0,0,0,23" />
            <UniformGrid Columns="4" Margin="0,0,-12,18">
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="↓  LIVE DOWNLOAD" FontSize="10" Foreground="{StaticResource AccentBrush}" /><StackPanel Orientation="Horizontal" Margin="0,12,0,6"><TextBlock x:Name="DownloadValue" Text="—" FontSize="32" FontWeight="SemiBold" /><TextBlock Text=" Mbps" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="2,0,0,6" /></StackPanel><TextBlock Text="Wi-Fi adapter traffic" FontSize="11" Style="{StaticResource Muted}" /></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="↑  LIVE UPLOAD" FontSize="10" Foreground="{StaticResource PurpleBrush}" /><StackPanel Orientation="Horizontal" Margin="0,12,0,6"><TextBlock x:Name="UploadValue" Text="—" FontSize="32" FontWeight="SemiBold" /><TextBlock Text=" Mbps" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="2,0,0,6" /></StackPanel><TextBlock Text="Wi-Fi adapter traffic" FontSize="11" Style="{StaticResource Muted}" /></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="◔  SIGNAL STRENGTH" FontSize="10" Foreground="#EBC582" /><StackPanel Orientation="Horizontal" Margin="0,12,0,6"><TextBlock x:Name="SignalValue" Text="—" FontSize="32" FontWeight="SemiBold" /><TextBlock x:Name="SignalUnit" Text=" dBm" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="2,0,0,6" /></StackPanel><TextBlock x:Name="SignalDescription" Text="Waiting for scan" FontSize="11" Style="{StaticResource Muted}" /></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="⇄  RECEIVE LINK RATE" FontSize="10" Foreground="#81B7FF" /><StackPanel Orientation="Horizontal" Margin="0,12,0,6"><TextBlock x:Name="LinkValue" Text="—" FontSize="32" FontWeight="SemiBold" /><TextBlock Text=" Mbps" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="2,0,0,6" /></StackPanel><TextBlock Text="Negotiated PHY · not internet speed" FontSize="10" Style="{StaticResource Muted}" /></StackPanel></Border>
            </UniformGrid>
            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="2.15*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Network activity" Style="{StaticResource SectionTitle}" /><TextBlock Text="↓ Download    ↑ Upload" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right" /></DockPanel><charts:TrafficChart x:Name="ActivityChart" Height="195" /><DockPanel Margin="0,8,0,0"><TextBlock Text="Last 120 seconds · Mbps" FontSize="10" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="SessionUsage" Text="Session: —" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" /></DockPanel></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Connection details" Style="{StaticResource SectionTitle}" /><TextBlock x:Name="ConnectionDetails" Text="Connect to Wi-Fi to see your link, gateway and security details." TextWrapping="Wrap" Foreground="#B7C8DE" LineHeight="26" /><Border Background="#152A32" CornerRadius="7" Padding="10" Margin="0,12,0,0"><TextBlock Text="Sky Gigafast+ Hub · XER10" FontSize="11" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" /></Border></StackPanel></Border>
            </Grid>
            <DockPanel><TextBlock Text="Your SSID across the spectrum" Style="{StaticResource SectionTitle}" /><TextBlock x:Name="ScanTimestamp" Text="Not scanned yet" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" /></DockPanel>
            <UniformGrid Columns="3" Margin="0,0,-12,18">
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="2.4 GHz" FontSize="20" FontWeight="SemiBold" Foreground="#EBC582" /><TextBlock Text="REACH &amp; COMPATIBILITY" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" /><TextBlock x:Name="Band24Summary" Text="No observations yet" TextWrapping="Wrap" LineHeight="23" /></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="5 GHz" FontSize="20" FontWeight="SemiBold" Foreground="#81B7FF" /><TextBlock Text="RANGE &amp; CAPACITY" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" /><TextBlock x:Name="Band5Summary" Text="No observations yet" TextWrapping="Wrap" LineHeight="23" /></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0" BorderBrush="#2B655F"><StackPanel><TextBlock Text="6 GHz" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="CLEAN SPECTRUM &amp; LOW LATENCY" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" /><TextBlock x:Name="Band6Summary" Text="No observations yet" TextWrapping="Wrap" LineHeight="23" /></StackPanel></Border>
            </UniformGrid>
            <Border Background="#11272C" CornerRadius="12" Padding="18"><DockPanel><Button DockPanel.Dock="Right" Content="Analyse my setup  →" Style="{StaticResource Primary}" Click="GoOptimiserClick" Margin="20,0,0,0" /><StackPanel><TextBlock Text="Built around your hardware" FontWeight="SemiBold" Margin="0,0,0,5" /><TextBlock Text="Discover supported settings, review a tailored plan, and trial changes with automatic recovery." Style="{StaticResource Muted}" /></StackPanel></DockPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Channels">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,26">
            <TextBlock Text="Find room to breathe." Style="{StaticResource Heading}" /><TextBlock Text="Explore nearby access points and the channels they occupy." Style="{StaticResource Muted}" />
            <WrapPanel Margin="0,20,0,18"><ComboBox x:Name="ChannelBand" SelectedIndex="2" SelectionChanged="ChannelBandChanged" Margin="0,0,12,0"><ComboBoxItem Content="2.4 GHz" /><ComboBoxItem Content="5 GHz" /><ComboBoxItem Content="6 GHz" /></ComboBox><TextBox x:Name="TargetSsidBox" Width="240" ToolTip="Your target SSID (exact name)" Margin="0,0,10,0" /><Button Content="Set target SSID" Click="SetTargetClick" /><CheckBox x:Name="ChannelOwnOnly" Content="Only my SSID" Checked="ChannelFilterChanged" Unchecked="ChannelFilterChanged" Margin="18,8,0,8" /></WrapPanel>
            <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Channel footprint" Style="{StaticResource SectionTitle}" /><TextBlock Text="● Your SSID     ● Neighbours" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" /></DockPanel><charts:SpectrumChart x:Name="Spectrum" Height="275" /><TextBlock Text="Signal in dBm · horizontal footprint uses advertised channel width when available. Curves illustrate overlap; they are not a spectrum analyser measurement." FontSize="11" Style="{StaticResource Muted}" Margin="0,12,0,0" /></StackPanel></Border>
            <TextBlock Text="Channel planning" Style="{StaticResource SectionTitle}" Margin="0,22,0,8" /><TextBlock Text="Lower overlap scores suggest fewer competing signals. Scores exclude your SSID and do not measure noise, hidden transmitters, airtime or achievable speed. UK planning ranges; the driver and hub enforce channel availability." Style="{StaticResource Muted}" Margin="0,0,0,12" />
            <DataGrid x:Name="ChannelTable" Height="250"><DataGrid.Columns><DataGridTextColumn Header="CHANNEL" Binding="{Binding Channel}" Width="110" /><DataGridTextColumn Header="FREQUENCY MHz" Binding="{Binding FrequencyMhz}" Width="150" /><DataGridTextColumn Header="OVERLAP SCORE ↓" Binding="{Binding ScoreLabel}" Width="160" /><DataGridTextColumn Header="OVERLAPPING APs" Binding="{Binding NearbyNetworks}" Width="155" /><DataGridTextColumn Header="CONTEXT" Binding="{Binding Note}" Width="*" /></DataGrid.Columns></DataGrid>
            <TextBlock Text="Sky controls hub channel selection. AirScope provides evidence and opens Sky's supported settings." Style="{StaticResource Muted}" Margin="0,14,0,0" />
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Networks">
          <Grid Margin="28,26"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Know your neighbourhood." Style="{StaticResource Heading}" /><TextBlock x:Name="NetworkCount" Text="Nearby access points, with one row per BSSID." Style="{StaticResource Muted}" /></StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,20,0,16"><TextBox x:Name="NetworkSearch" Width="250" ToolTip="Filter by SSID, BSSID, channel or security" TextChanged="NetworkFilterChanged" Margin="0,0,12,0" /><ComboBox x:Name="NetworkBand" SelectedIndex="0" SelectionChanged="NetworkBandChanged"><ComboBoxItem Content="All bands" /><ComboBoxItem Content="2.4 GHz" /><ComboBoxItem Content="5 GHz" /><ComboBoxItem Content="6 GHz" /></ComboBox><CheckBox x:Name="NetworkOwnOnly" Content="Only my SSID" Checked="NetworkFilterChanged" Unchecked="NetworkFilterChanged" Margin="18,8,0,8" /></WrapPanel>
            <DataGrid Grid.Row="2" x:Name="NetworkTable" SelectionChanged="NetworkSelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="SSID" Binding="{Binding Name}" Width="*" MinWidth="135" /><DataGridTextColumn Header="BAND" Binding="{Binding BandLabel}" Width="90" /><DataGridTextColumn Header="CH" Binding="{Binding Channel}" Width="55" /><DataGridTextColumn Header="dBm" Binding="{Binding Rssi}" Width="70" /><DataGridTextColumn Header="WIDTH" Binding="{Binding WidthLabel}" Width="105" /><DataGridTextColumn Header="STANDARD" Binding="{Binding Standard}" Width="110" /><DataGridTextColumn Header="SECURITY" Binding="{Binding Security}" Width="160" /><DataGridTextColumn Header="AP LOAD" Binding="{Binding LoadLabel}" Width="100" /></DataGrid.Columns></DataGrid>
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Connect saved profile" Click="ConnectClick" Margin="18,0,0,0" /><TextBlock x:Name="SelectedNetworkDetails" Text="Select an access point to inspect its BSSID, frequency and beacon details." Style="{StaticResource Muted}" VerticalAlignment="Center" /></DockPanel></Border>
          </Grid>
        </TabItem>
        <TabItem Header="Diagnostics">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,26">
            <TextBlock Text="Measure what matters." Style="{StaticResource Heading}" /><TextBlock Text="Test internet throughput and connection quality, then compare your SSID across bands." Style="{StaticResource Muted}" />
            <Border Style="{StaticResource Card}" Margin="0,20,0,18"><StackPanel><WrapPanel><Button x:Name="SpeedButton" Content="▶  Test current connection" Style="{StaticResource Primary}" Click="SpeedClick" Margin="0,0,12,0" /><Button x:Name="CompareButton" Content="Compare available bands" Click="CompareBandsClick" Margin="0,0,12,0" /><Button x:Name="CancelButton" Content="Cancel test" Click="CancelTestClick" IsEnabled="False" /><CheckBox x:Name="IncludeUpload" Content="Include upload" IsChecked="True" Margin="18,8,0,8" /></WrapPanel><TextBlock x:Name="TestProgress" Text="Tests use Cloudflare over HTTPS. Up to 128 MB download + 16 MB upload per band. Other traffic and server capacity affect results." Style="{StaticResource Muted}" Margin="0,15,0,0" /><UniformGrid Columns="2" Margin="0,20,0,0"><StackPanel><TextBlock Text="MEASURED DOWNLOAD" Foreground="{StaticResource AccentBrush}" FontSize="10" /><TextBlock x:Name="MeasuredDownload" Text="— Mbps" FontSize="38" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel><StackPanel><TextBlock Text="MEASURED UPLOAD" Foreground="{StaticResource PurpleBrush}" FontSize="10" /><TextBlock x:Name="MeasuredUpload" Text="— Mbps" FontSize="38" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></UniformGrid></StackPanel></Border>
            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Latency &amp; packet loss" Style="{StaticResource SectionTitle}" /><Button x:Name="LatencyButton" Content="Run probes" Click="LatencyClick" HorizontalAlignment="Right" Padding="12,6" /></DockPanel><TextBlock x:Name="LatencyText" Text="Compare the local gateway with 1.1.1.1 and 8.8.8.8. ICMP may be filtered; packet loss is not proof of a Wi-Fi fault." Style="{StaticResource Muted}" Margin="0,12,0,0" /></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="DNS resolution" Style="{StaticResource SectionTitle}" /><Button Content="Check DNS" Click="DnsClick" HorizontalAlignment="Right" Padding="12,6" /></DockPanel><TextBlock x:Name="DnsText" Text="Time a system DNS lookup. Results may come from the local resolver cache." Style="{StaticResource Muted}" Margin="0,12,0,0" /></StackPanel></Border>
            </Grid>
            <TextBlock Text="Measured history" Style="{StaticResource SectionTitle}" /><DataGrid x:Name="SpeedHistoryTable" Height="235"><DataGrid.Columns><DataGridTextColumn Header="WHEN" Binding="{Binding Time, StringFormat={}{0:dd MMM HH:mm:ss}}" Width="160" /><DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="*" /><DataGridTextColumn Header="BAND" Binding="{Binding BandLabel}" Width="100" /><DataGridTextColumn Header="DOWNLOAD Mbps" Binding="{Binding DownloadMbps, StringFormat=F1}" Width="170" /><DataGridTextColumn Header="UPLOAD Mbps" Binding="{Binding UploadMbps, StringFormat=F1}" Width="150" /></DataGrid.Columns></DataGrid>
            <TextBlock Text="Measurements apply only to the tested connection and time. Wi-Fi bands cannot all be speed-tested simultaneously by one radio." Style="{StaticResource Muted}" Margin="0,14,0,0" />
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Optimiser">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,26">
            <TextBlock Text="Tune with a way back." Style="{StaticResource Heading}" /><TextBlock Text="An evidence-led plan for the MediaTek MT7925 and your Sky Gigafast+ Hub." Style="{StaticResource Muted}" />
            <Border Background="#112C2D" CornerRadius="12" Padding="20" Margin="0,20,0,18"><StackPanel><TextBlock Text="A protected, three-minute trial" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="AirScope captures original driver values, verifies a new Windows restore point, and installs an independent rollback task before applying changes. Keep the trial in Recovery, or Windows restores it automatically—even if AirScope closes." TextWrapping="Wrap" LineHeight="23" Foreground="#BAD3D3" Margin="0,9,0,0" /></StackPanel></Border>
            <WrapPanel Margin="0,0,0,18"><Button x:Name="PlanButton" Content="✧  Analyse &amp; build plan" Style="{StaticResource Primary}" Click="BuildPlanClick" Margin="0,0,12,0" /><Button x:Name="ApplyButton" Content="Trial this plan…" Click="ApplyPlanClick" IsEnabled="False" Margin="0,0,12,0" /><Button Content="Open System Protection" Click="SystemProtectionClick" /></WrapPanel>
            <TextBlock x:Name="PlanSummary" Text="Start with a scan and hardware read. Changes are proposed only when the installed driver exposes a supported value." Style="{StaticResource Muted}" Margin="0,0,0,15" />
            <DataGrid x:Name="PlanTable" Height="280" RowHeight="64"><DataGrid.Columns><DataGridTextColumn Header="SETTING" Binding="{Binding Name}" Width="190" /><DataGridTextColumn Header="CURRENT" Binding="{Binding Before}" Width="180" /><DataGridTextColumn Header="PROPOSED" Binding="{Binding After}" Width="190" /><DataGridTextColumn Header="WHY" Binding="{Binding Reason}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="VerticalAlignment" Value="Center" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
            <TextBlock Text="Setup guidance" Style="{StaticResource SectionTitle}" Margin="0,22,0,10" /><TextBlock x:Name="PlanAdvice" Text="The optimiser preserves WPA3, leaves TCP and DNS settings alone, and uses band preferences so fallback remains available. Driver and router firmware updates stay with their supported vendor tools." Style="{StaticResource Muted}" />
            <TextBlock Text="Windows may block a new restore point when System Protection is off or a point was created in the last 24 hours. If verification fails, the tuning does not run. More speed is not guaranteed; use before/after tests." Foreground="#E0BE83" TextWrapping="Wrap" LineHeight="22" Margin="0,20,0,0" />
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Hardware">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,26">
            <TextBlock Text="Know the whole connection." Style="{StaticResource Heading}" /><TextBlock Text="The adapter, the driver and the hub each shape your Wi-Fi experience." Style="{StaticResource Muted}" />
            <WrapPanel Margin="0,20,0,16"><ComboBox x:Name="AdapterPicker" Width="470" DisplayMemberPath="Description" SelectionChanged="AdapterChanged" Margin="0,0,12,0" /><Button Content="Read hardware" Click="ReadHardwareClick" Margin="0,0,12,0" /><Button Content="Read protected hardware" Click="ReadProtectedHardwareClick" /></WrapPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Your Wi-Fi adapter" Style="{StaticResource SectionTitle}" /><TextBlock x:Name="HardwareText" Text="Adapter details appear after a hardware read. Protected reads request Windows administrator access." Style="{StaticResource Muted}" /><TextBlock x:Name="DriverText" Text="" Style="{StaticResource Muted}" Margin="0,12,0,0" /></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Sky Gigafast+ Hub · XER10" Style="{StaticResource SectionTitle}" /><TextBlock Text="Your configured router model. Tri-band Wi-Fi 7, with 2.4, 5 and 6 GHz access points discovered from your SSID. Firmware, channel selection and account controls are managed by Sky." Style="{StaticResource Muted}" /><WrapPanel Margin="0,14,0,0"><Button Content="Hub admin" Click="RouterClick" Margin="0,0,10,0" /><Button Content="Sky Wi-Fi settings ↗" Click="SkyHelpClick" /></WrapPanel></StackPanel></Border>
            </Grid>
            <TextBlock Text="Installed driver settings" Style="{StaticResource SectionTitle}" Margin="0,22,0,10" /><DataGrid x:Name="PropertiesTable" Height="360"><DataGrid.Columns><DataGridTextColumn Header="SETTING" Binding="{Binding DisplayName}" Width="*" /><DataGridTextColumn Header="CURRENT VALUE" Binding="{Binding DisplayValue}" Width="*" /><DataGridTextColumn Header="DRIVER KEYWORD" Binding="{Binding RegistryKeyword}" Width="220" /></DataGrid.Columns></DataGrid>
            <TextBlock Text="The hub model comes from your setup description; matching an SSID does not authenticate the router. Channel widths and AP load appear only when the driver supplies the relevant beacon information. MLO link telemetry is not available through this app's current API." Style="{StaticResource Muted}" Margin="0,16,0,0" />
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Recovery">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,26">
            <TextBlock Text="You're in control." Style="{StaticResource Heading}" /><TextBlock Text="Review trials, restore original settings, and decide how AirScope runs." Style="{StaticResource Muted}" />
            <Border x:Name="TrialBanner" Background="#30271B" CornerRadius="12" Padding="18" Margin="0,20,0,0" Visibility="Collapsed"><TextBlock x:Name="TrialCountdown" TextWrapping="Wrap" Foreground="#F2D397" FontSize="15" /></Border>
            <WrapPanel Margin="0,20,0,16"><Button Content="Refresh recovery" Click="RefreshRecoveryClick" Margin="0,0,12,0" /><Button Content="Save adapter snapshot" Click="SnapshotClick" Margin="0,0,12,0" /><Button x:Name="KeepButton" Content="Keep selected trial" Style="{StaticResource Primary}" Click="KeepClick" Margin="0,0,12,0" /><Button Content="Restore selected snapshot…" Click="RollbackClick" /></WrapPanel>
            <DataGrid x:Name="RecoveryTable" Height="220"><DataGrid.Columns><DataGridTextColumn Header="CREATED" Binding="{Binding CreatedAt, StringFormat={}{0:dd MMM HH:mm:ss}}" Width="160" /><DataGridTextColumn Header="ADAPTER" Binding="{Binding Adapter}" Width="110" /><DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="120" /><DataGridTextColumn Header="DETAILS" Binding="{Binding Description}" Width="*" /></DataGrid.Columns></DataGrid>
            <TextBlock Text="Snapshots restore captured adapter properties. Windows restore points are a separate system-level recovery option, available through System Protection. A snapshot does not back up router settings, passwords or personal files." Style="{StaticResource Muted}" Margin="0,14,0,22" />
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Automation &amp; appearance" Style="{StaticResource SectionTitle}" /><CheckBox x:Name="AutoScanSetting" Content="Refresh nearby Wi-Fi every 20 seconds" Checked="SettingsChanged" Unchecked="SettingsChanged" /><CheckBox x:Name="TraySetting" Content="Minimise to the system tray (closing the window exits)" Checked="SettingsChanged" Unchecked="SettingsChanged" /><CheckBox x:Name="WidgetSetting" Content="Show a compact always-on-top speed widget" Checked="SettingsChanged" Unchecked="SettingsChanged" /><CheckBox x:Name="DesktopSetting" Content="This is a desktop PC: allow driver power-saving changes in optimisation plans" Checked="SettingsChanged" Unchecked="SettingsChanged" /><TextBlock Text="Scans and live traffic monitoring are automatic. Internet tests and protected changes begin when you start them. Each tuning trial requires Keep so a lost connection cannot silently become permanent." Style="{StaticResource Muted}" Margin="0,10,0,0" /></StackPanel></Border>
            <WrapPanel Margin="0,20,0,0"><Button Content="Export access points (CSV)" Click="ExportCsvClick" Margin="0,0,12,0" /><Button Content="Open local data" Click="OpenDataClick" Margin="0,0,12,0" /><Button Content="Location settings" Click="LocationClick" Margin="0,0,12,0" /><Button Content="System Protection" Click="SystemProtectionClick" /></WrapPanel>
            <TextBlock Text="No telemetry or cloud account. Settings and measured history stay in your Windows profile. Speed tests contact Cloudflare; external links open only when clicked. Exported reports hide SSID and MAC addresses by default." Style="{StaticResource Muted}" Margin="0,16,0,0" />
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
      <Border Grid.Row="3" Background="#0D1623" BorderBrush="#233247" BorderThickness="0,1,0,0" Padding="28,0"><DockPanel><TextBlock x:Name="FooterClock" DockPanel.Dock="Right" Foreground="#607691" FontSize="10" VerticalAlignment="Center" /><TextBlock x:Name="StatusText" Text="Starting AirScope…" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></Border>
    </Grid>
  </Grid>
</Window>
